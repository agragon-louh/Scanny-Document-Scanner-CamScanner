<?xml version="1.0" encoding="utf-8"?>
<!--
    Only expose the directories the app actually shares from. The previous config
    (external-path ".") let any granted URI address the whole shared storage.
-->
<paths>
    <!-- Internal storage: page images and signatures (see AppStorage) -->
    <files-path
        name="documents"
        path="Documents/" />
    <files-path
        name="signatures"
        path="Signature/" />
    <!-- Old location (Android/data/<pkg>/files), for pages whose migration has not finished -->
    <external-files-path
        name="app_files"
        path="." />
    <!-- Exported PDFs / images: Download/Scanny/... -->
    <external-path
        name="scanny_exports"
        path="Download/Scanny/" />
    <!-- :scanlibrary camera capture (ScanConstants.IMAGE_PATH) -->
    <external-path
        name="scan_sample"
        path="Download/scanSample/" />
    <!-- Share-only files: PDFs, images, QR codes -->
    <cache-path
        name="cache"
        path="." />
</paths>
