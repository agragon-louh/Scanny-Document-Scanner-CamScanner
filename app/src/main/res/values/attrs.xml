<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="BarcodeScannerView">
        <attr name="shouldScaleToFill" format="boolean" />
        <attr name="laserEnabled" format="boolean" />
        <attr name="laserColor" format="color" />
        <attr name="borderColor" format="color" />
        <attr name="maskColor" format="color" />
        <attr name="borderWidth" format="dimension" />
        <attr name="borderLength" format="dimension" />
        <attr name="roundedCorner" format="boolean" />
        <attr name="cornerRadius" format="dimension" />
        <attr name="squaredFinder" format="boolean" />
        <attr name="barcode_borderAlpha" format="float" />
        <attr name="finderOffset" format="dimension" />
    </declare-styleable>

    <!-- com.scanny.scanner.widget.ColorSeekBar (replaces com.divyanshu.colorseekbar) -->
    <declare-styleable name="ColorSeekBar">
        <attr name="csb_colorSeeds" format="reference" />
    </declare-styleable>

    <!-- com.scanny.scanner.widget.SignatureView (replaces com.kyanogen.signatureview) -->
    <declare-styleable name="SignatureView">
        <attr name="sv_penColor" format="color" />
        <attr name="sv_penSize" format="dimension" />
        <attr name="sv_backgroundColor" format="color" />
        <attr name="sv_enableSignature" format="boolean" />
    </declare-styleable>
</resources>