<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- namespace is set in scanlibrary/build.gradle (required by AGP 8+). -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Storage permissions are only honoured on old Android versions; see app manifest. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <activity
            android:name=".ScanActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="@string/app_name" />

        <!--
            No FileProvider here any more: it had the same class name as the app's provider, so
            the manifest merger replaced it anyway. PickImageFragment uses the app's
            "${applicationId}.provider" (see app/src/main/res/xml/provider_paths.xml).
        -->
    </application>

</manifest>
